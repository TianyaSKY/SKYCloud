# Run python3 scripts/generate-env.py to create .env with unique random secrets.
# =================================================================
# PostgreSQL 数据库配置
# =================================================================
POSTGRES_USER=skycloud
POSTGRES_PASSWORD=
POSTGRES_DB=skycloud_db
POSTGRES_PORT=5432

# =================================================================
# Redis 缓存/锁配置
# =================================================================
REDIS_PORT=6379

# =================================================================
# RabbitMQ 队列配置
# =================================================================
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=skycloud
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# =================================================================
# 后端配置
# =================================================================
BACKEND_API_PORT=5000
# 文件上传在宿主机的存储路径 (分片临时文件仍用本地)
UPLOAD_HOST_PATH=./data/uploads
# Worker 最大线程数
WORKER_MAX_THREADS=20

# =================================================================
# MinIO 对象存储配置
# =================================================================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=skycloud
MINIO_SECRET_KEY=
MINIO_BUCKET=skycloud
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# =================================================================
# 前端配置
# =================================================================
FRONTEND_PORT=80

# =================================================================
# 业务逻辑配置
# =================================================================
# 默认模型密码
DEFAULT_MODEL_PWD=

# 模型配置
CHAT_API_URL=https://yujianwudi.top/v1
CHAT_API_KEY=
CHAT_API_MODEL=openai/gpt-5.6-luna

EMB_API_URL=https://api.siliconflow.cn/v1/
EMB_API_KEY=
EMB_MODEL_NAME=BAAI/bge-m3

VL_API_URL=https://yujianwudi.top/v1
VL_API_KEY=
VL_API_MODEL=openai/gpt-5.6-luna

# RAG 重排序模型配置
RERANK_API_URL=https://api.siliconflow.cn/v1/
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=8
RAG_VECTOR_FETCH_K=20

# =================================================================
# MCP Server 配置
# =================================================================
MCP_PORT=5001

SECRET_KEY=

# =================================================================
# OpenCode 工作区 (Manus-style Sandbox) 配置
# =================================================================
# 由 scripts/build-runtime-image.py --env-file .env 写入不可变镜像 ID
OPENCODE_IMAGE=
# OpenCode Server Basic Auth derivation secret (never send to the browser)
OPENCODE_SERVER_SECRET=
OPENCODE_SERVER_USERNAME=skycloud
# Expert agent name provisioned into each runtime config
OPENCODE_EXPERT_AGENT=skycloud-expert
# API reaches Runtime through RUNTIME_CONTROLLER_URL below. No Runtime port is published.
# MCP and model gateway stay inside Compose even if API/Worker run locally.
# OPENCODE_MCP_URL=http://skycloud-backend-mcp:5001/mcp
OPENCODE_STARTUP_TIMEOUT=30
# 专家模式通过模型网关使用上方 CHAT 配置。真实 API Key 不写入 Runtime。
OPENCODE_LLM_GATEWAY_URL=http://skycloud-llm-gateway:5002/v1
RUNTIME_LLM_TOKEN_TTL_SECONDS=3600
RUNTIME_LLM_HOURLY_TOKEN_BUDGET=100000
RUNTIME_LLM_HOURLY_REQUEST_LIMIT=60
RUNTIME_LLM_MAX_OUTPUT_TOKENS=4096
# Feature rollout flags
ASSISTANT_V2_ENABLED=true
ASSISTANT_EXPERT_ENABLED=true
ASSISTANT_PERMISSION_UI_ENABLED=true
ASSISTANT_RUNTIME_LOCK_TTL=3600
# Runtime 专用内网，禁止连接数据库/缓存/对象存储网络
SKYCLOUD_DOCKER_NETWORK=skycloud_runtime-network
# 单个工作区内存限制
WORKSPACE_MEM_LIMIT=1g
# 单个工作区 CPU 配额 (100000 = 1 核心)
WORKSPACE_CPU_QUOTA=100000
WORKSPACE_CPU_PERIOD=100000
# 每个用户最多创建的工作区数量
MAX_WORKSPACES_PER_USER=3

# Controller-only Docker access; generate a separate random service credential.
RUNTIME_CONTROLLER_TOKEN=
RUNTIME_CONTROLLER_URL=http://127.0.0.1:5003
# Linux: set this to the host Docker socket group ID (stat -c %g /var/run/docker.sock).
DOCKER_SOCKET_GID=0

# Upload limits in bytes. All values must be positive; zero does not disable protection.
UPLOAD_MAX_FILE_SIZE=268435456
UPLOAD_MAX_AVATAR_SIZE=5242880
UPLOAD_MAX_REQUEST_SIZE=536870912
UPLOAD_MAX_CHUNK_SIZE=67108864
UPLOAD_MAX_TOTAL_CHUNKS=10000
UPLOAD_CHUNK_SIZE=2097152

# Stored bytes plus active reservations; per-user and per-workspace limits.
UPLOAD_USER_CAPACITY=10737418240
UPLOAD_WORKSPACE_CAPACITY=53687091200
# Daily admission charged at initialization; aborts/failures do not refund it.
UPLOAD_DAILY_BYTES=5368709120
UPLOAD_DAILY_ATTEMPTS=200
UPLOAD_USER_CONCURRENCY=8
UPLOAD_WORKSPACE_CONCURRENCY=32
UPLOAD_RESERVATION_TTL_SECONDS=3600
# Request concurrency is per API process; ingress also bounds each client IP.
UPLOAD_REQUEST_CONCURRENCY=8

# MCP inline upload remains 8 MiB; JSON RPC bodies and concurrency are bounded.
MCP_MAX_REQUEST_SIZE=33554432
MCP_REQUEST_CONCURRENCY=4

# Public parent origin and per-runtime host. Production needs wildcard DNS/TLS.
# Example: https://r{runtime_id}.runtime.example.com (separate from APP_ORIGIN).
APP_ORIGIN=http://app.skycloud.localhost
RUNTIME_UI_PORT=8081
RUNTIME_UI_ORIGIN_TEMPLATE=http://r{runtime_id}.skycloud.localhost:8081
