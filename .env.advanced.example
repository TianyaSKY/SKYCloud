# =================================================================
# SKYCloud 高级部署可选配置 (.env.advanced)
# 如需自定义域名、外部端口、安全证书或资源限额，可复制本文件为 .env.advanced
# 默认配置下无需创建此文件，系统均有内置安全默认值
# =================================================================

# -----------------------------------------------------------------
# 域名与公网网络配置
# -----------------------------------------------------------------
# 外部访问主域名 (系统默认放行所有 Origin；若需严格限制跨源白名单可在此指定具体 Origin)
# APP_ORIGIN=http://app.skycloud.localhost
# 前端发布端口 (默认: 80)
# FRONTEND_PORT=80
# 沙箱 Web 终端发布端口 (默认: 8081)
# RUNTIME_UI_PORT=8081
# 外部沙箱终端 URL 模板 (支持子域名泛解析)
# RUNTIME_UI_ORIGIN_TEMPLATE=http://r{runtime_id}.skycloud.localhost:8081
# 浏览器 CSP 安全白名单来源
# RUNTIME_UI_CSP_SOURCE=http://*.skycloud.localhost:8081

# -----------------------------------------------------------------
# 宿主机文件存储路径
# -----------------------------------------------------------------
# UPLOAD_HOST_PATH=./data/uploads

# -----------------------------------------------------------------
# 多模态视觉 (VL) 与重排序 (Rerank) 可选高级模型
# 若 Chat 模型本身具备视觉能力 (如 gpt-4o, claude-3, gemini 等)，系统会自动复用
# -----------------------------------------------------------------
# 强制声明 Chat 模型是否支持视觉输入 (true / false)
# CHAT_SUPPORTS_VISION=true
# 独立 VL 模型配置 (若未提供且 Chat 不支持视觉，文档将自动降级为纯文本抽取分析)
# VL_API_URL=https://api.siliconflow.cn/v1
# VL_API_KEY=
# VL_API_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# 独立重排模型配置 (若未提供将自动跳过重排，保留稠密向量与 RRF 检索)
# RERANK_API_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_TOP_K=8
# RAG_VECTOR_FETCH_K=20

# -----------------------------------------------------------------
# 沙箱资源隔离与配额
# -----------------------------------------------------------------
# 单个工作区内存上限
# WORKSPACE_MEM_LIMIT=1g
# 单个工作区 CPU 配额 (100000 = 1 核心)
# WORKSPACE_CPU_QUOTA=100000
# 单个工作区 CPU 周期
# WORKSPACE_CPU_PERIOD=100000
# 单个用户最大创建工作区数量
# MAX_WORKSPACES_PER_USER=3
# 工作区沙箱启动等待超时时间 (秒)
# OPENCODE_STARTUP_TIMEOUT=30

# -----------------------------------------------------------------
# 宿主机 Docker Socket GID (Linux 宿主机环境)
# DOCKER_SOCKET_GID=0

# -----------------------------------------------------------------
# 后台 Worker 任务并发线程数
# -----------------------------------------------------------------
# WORKER_MAX_THREADS=20
# WORKER_ORGANIZE_THREADS=1

# -----------------------------------------------------------------
# 上传配额与限额 (字节数)
# -----------------------------------------------------------------
# UPLOAD_MAX_FILE_SIZE=268435456
# UPLOAD_MAX_AVATAR_SIZE=5242880
# UPLOAD_MAX_REQUEST_SIZE=536870912
# UPLOAD_MAX_CHUNK_SIZE=67108864
# UPLOAD_CHUNK_SIZE=2097152
# UPLOAD_USER_CAPACITY=10737418240
# UPLOAD_WORKSPACE_CAPACITY=53687091200
# UPLOAD_DAILY_BYTES=5368709120
# UPLOAD_DAILY_ATTEMPTS=200
# UPLOAD_USER_CONCURRENCY=8
# UPLOAD_WORKSPACE_CONCURRENCY=32
# UPLOAD_REQUEST_CONCURRENCY=8
