# =================================================================
# PostgreSQL 数据库配置
# =================================================================
POSTGRES_USER=tianya
POSTGRES_PASSWORD=pwd
POSTGRES_DB=skycloud_db
POSTGRES_PORT=5432

# =================================================================
# Redis 缓存/锁配置
# =================================================================
REDIS_PORT=6379

# =================================================================
# RabbitMQ 队列配置
# =================================================================
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=skycloud
RABBITMQ_PASSWORD=skycloud
RABBITMQ_VHOST=/

# =================================================================
# 后端配置
# =================================================================
BACKEND_API_PORT=5000
# 文件上传在宿主机的存储路径 (分片临时文件仍用本地)
UPLOAD_HOST_PATH=D:\SKYCloudFilesUpload
# Worker 最大线程数
WORKER_MAX_THREADS=5
# Worker 单批最多处理的文件索引任务数
WORKER_BATCH_SIZE=10

# =================================================================
# MinIO 对象存储配置
# =================================================================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=skycloud
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# =================================================================
# 前端配置
# =================================================================
FRONTEND_PORT=80

# =================================================================
# 业务逻辑配置
# =================================================================
# 默认模型密码
DEFAULT_MODEL_PWD=pwd

# 模型配置
CHAT_API_URL=https://openrouter.ai/api/v1
CHAT_API_KEY=
CHAT_API_MODEL=arcee-ai/trinity-large-preview:free

EMB_API_URL=https://api.siliconflow.cn/v1
EMB_API_KEY=
EMB_MODEL_NAME=BAAI/bge-large-en-v1.5

VL_API_URL=https://api.siliconflow.cn/v1
VL_API_KEY=
VL_API_MODEL=zai-org/GLM-4.6V

# RAG 重排序模型配置
RERANK_API_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=8
RAG_VECTOR_FETCH_K=20

# =================================================================
# MCP Server 配置
# =================================================================
MCP_PORT=5001

SECRET_KEY=replace-with-a-long-random-secret

# =================================================================
# OpenCode 工作区 (Manus-style Sandbox) 配置
# =================================================================
# OpenCode 官方镜像。首次创建专家 Runtime 时会自动拉取；生产建议固定版本或 digest。
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:latest
# OpenCode Server Basic Auth derivation secret (never send to the browser)
OPENCODE_SERVER_SECRET=replace-with-a-different-long-random-secret
OPENCODE_SERVER_USERNAME=skycloud
# Expert agent name provisioned into each runtime config
OPENCODE_EXPERT_AGENT=skycloud-expert
# Optional Runtime URL template. Leave unset to auto-detect Docker API versus
# local API + Docker Runtime hybrid development.
# OPENCODE_RUNTIME_BASE_URL=http://skycloud-opencode-w{workspace_id}-u{user_id}:3000
# Optional MCP endpoint visible from the Runtime container. For a local MCP on
# Docker Desktop, the automatic value is http://host.docker.internal:5001/mcp.
# OPENCODE_MCP_URL=http://host.docker.internal:5001/mcp
OPENCODE_STARTUP_TIMEOUT=30
# Feature rollout flags
ASSISTANT_V2_ENABLED=true
ASSISTANT_EXPERT_ENABLED=true
ASSISTANT_PERMISSION_UI_ENABLED=true
ASSISTANT_RUNTIME_LOCK_TTL=3600
# 容器加入的网络，需要与主服务网络互通
SKYCLOUD_DOCKER_NETWORK=skycloud_skycloud-network
# 单个工作区内存限制
WORKSPACE_MEM_LIMIT=1g
# 单个工作区 CPU 配额 (100000 = 1 核心)
WORKSPACE_CPU_QUOTA=100000
WORKSPACE_CPU_PERIOD=100000
# 每个用户最多创建的工作区数量
MAX_WORKSPACES_PER_USER=3
